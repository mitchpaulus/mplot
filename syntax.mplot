f "file.tsv"
font "Arial"
w 6
h 3-1/2 {- Rational numbers are used -}
fs 8 {- fontsize -}
dpi 300
out "plot.png"

{- data formats -}
sep "," {- or -}
tab
,

ct "Chart Title"

xl "X Axis Label"
yl "Y Axis Label"

x 1 {- x column -}
y 2 {- y column -}
{- Can also do it by name -}

g {- grid -}

START
1 2
3 4
END

xr 0:100 {- x range -}
xr :100
xr 0:
yr 0 to 10

{- marker types -}
o + -

s "Series 1" "Series 2"

lw 2 {- line width -}
dt ".-" "--" {- dash types -}
text "My Label" 10 20 {- place a text annotation -}
text 10 20 "My Label" {- string may also come last -}
arrow 10 20 30 35 {- draw an arrow annotation -}

{- time axis settings -}
time
tf "%Y-%m-%d"
tf "yyyy-mm-ddThh:nn:ss" {- y m d h(24) c(12) n(minute) s ampm, case-insensitive -}
xf "mmm d c ampm" {- Jan 5 9 pm, doubled letters zero pad -}
isodate {- for "%Y-%m-%d" -}

{- legend locations -}
top right ul upperleft ur upperright

{- colors -}
#000000 {- hex -}
rgb 123 124 125 {- rgb -}
red green blue black orange ccblue ccgray ccmaroon ccgreen ccyellow {- named -}
